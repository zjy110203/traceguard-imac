{
  "additionalProperties": false,
  "properties": {
    "strategy": {
      "enum": [
        "role",
        "accessible_name",
        "label",
        "placeholder",
        "test_id",
        "css",
        "xpath"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "value": {
      "minLength": 1,
      "title": "Value",
      "type": "string"
    },
    "source": {
      "default": "human",
      "enum": [
        "human",
        "compiler",
        "healed"
      ],
      "title": "Source",
      "type": "string"
    },
    "stability_score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stability Score"
    }
  },
  "required": [
    "strategy",
    "value"
  ],
  "title": "LocatorSpec",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
