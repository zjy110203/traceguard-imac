# TraceGuard LLM 配置样例（复制为 .env 后填入真实值；.env 已被 .gitignore 排除，严禁提交）
# DeepSeek API Key（只放环境变量或 .env，不进代码/文档/Git）
DEEPSEEK_API_KEY=sk-your-key-here
# 启用 DeepSeek 作为 LLM Provider（留空则全部使用规则引擎）
TG_LLM_PROVIDER=deepseek
# 可选覆盖（默认值见 packages/core/traceguard_core/config.py）
# TG_LLM_DEFAULT_MODEL=deepseek-flash
# TG_LLM_REASONING_MODEL=deepseek-v4-pro
# TG_LLM_DAILY_BUDGET_USD=1.0

# RUN-009 WP2：真实身份认证与 RBAC（默认显式关闭，dev/迁移用；开启后 /api/v1/** fail-closed）
# TG_AUTH_ENABLED=true
# TG_AUTH_SESSION_TTL_S=28800
# TG_AUTH_COOKIE_NAME=tg_session
# TG_AUTH_COOKIE_SECURE=false
# TG_AUTH_CSRF_REQUIRED=true
# TG_AUTH_MAX_FAILED_LOGINS=5
# TG_AUTH_LOGIN_WINDOW_S=300
# 管理员初始化：TG_BOOTSTRAP_USERNAME / TG_BOOTSTRAP_PASSWORD（只经环境变量或交互输入，不写入仓库）
