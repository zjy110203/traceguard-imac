{
  "additionalProperties": false,
  "properties": {
    "step_id": {
      "title": "Step Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "index": {
      "minimum": 0,
      "title": "Index",
      "type": "integer"
    },
    "status": {
      "default": "PENDING",
      "enum": [
        "PENDING",
        "RUNNING",
        "PASSED",
        "FAILED",
        "SKIPPED",
        "TIMED_OUT",
        "CANCELLED",
        "BLOCKED"
      ],
      "title": "Status",
      "type": "string"
    },
    "skip_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skip Reason"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "step_id",
    "run_id",
    "index"
  ],
  "title": "Step",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
