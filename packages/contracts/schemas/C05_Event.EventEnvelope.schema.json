{
  "additionalProperties": false,
  "description": "F01/F02/G02/G05 修订后：workspace_id 必填且服务端注入；context_refs 统一关联；\noccurred_at 与 observed_at 分离；幂等键 producer 维度唯一。",
  "properties": {
    "event_id": {
      "pattern": "^evt_[A-Za-z0-9_]+$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "context_refs": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Context Refs",
      "type": "object"
    },
    "producer_id": {
      "title": "Producer Id",
      "type": "string"
    },
    "producer_instance_id": {
      "title": "Producer Instance Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "occurred_at": {
      "title": "Occurred At",
      "type": "string"
    },
    "observed_at": {
      "title": "Observed At",
      "type": "string"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "workspace_id",
    "producer_id",
    "producer_instance_id",
    "sequence",
    "occurred_at",
    "observed_at",
    "idempotency_key"
  ],
  "title": "EventEnvelope",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
