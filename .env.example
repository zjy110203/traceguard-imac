# TraceGuard 配置样例（复制为 .env 后填入真实值；.env 已被 .gitignore 排除，严禁提交）

# ---- LLM ----
# DeepSeek API Key（只放环境变量或 .env，不进代码/文档/Git）
DEEPSEEK_API_KEY=sk-your-key-here
# 启用 DeepSeek 作为 LLM Provider（留空则全部使用规则引擎）
TG_LLM_PROVIDER=deepseek
# 可选覆盖（默认值见 packages/core/traceguard_core/config.py）
# TG_LLM_DEFAULT_MODEL=deepseek-flash
# TG_LLM_REASONING_MODEL=deepseek-v4-pro
# TG_LLM_DAILY_BUDGET_USD=1.0

# ---- 认证与 RBAC（RUN-010 WP1 环境策略强制）----
# 环境分级策略（apps/api/traceguard_api/auth_policy.py，启动期强制）：
#   development/test/local/ci : 允许显式关闭（启动日志打醒目警告）
#   staging                   : 必须开启；显式关闭 → 启动失败
#   production                : 必须开启；显式关闭 / TG_AUTH_COOKIE_SECURE=false /
#                               TG_AUTH_SESSION_TTL_S > 86400 → 启动失败（fail-closed）
# 未显式设置 TG_AUTH_ENABLED 且 environment=staging/production 时按「默认开启」处理。
# TG_AUTH_ENABLED=true
# TG_ENVIRONMENT=development
# TG_AUTH_SESSION_TTL_S=28800
# TG_AUTH_COOKIE_NAME=tg_session
# TG_AUTH_COOKIE_SECURE=false      # production 必须 true（HTTPS 会话 Cookie）
# TG_AUTH_CSRF_REQUIRED=true
# TG_AUTH_MAX_FAILED_LOGINS=5      # 登录失败限速阈值（数据库级计数，多进程共享）
# TG_AUTH_LOGIN_WINDOW_S=300

# 管理员初始化（两种方式等价；密码只经环境变量/交互/CLI 参数，不写入仓库）：
#   TG_BOOTSTRAP_USERNAME=admin TG_BOOTSTRAP_PASSWORD='...' .venv/bin/python scripts/auth_bootstrap.py
#   .venv/bin/python scripts/auth_bootstrap.py --db <DSN> --username admin --password '...' \
#     --roles platform-admin --workspaces '["*"]'

# ---- 数据库 ----
# 默认项目内 SQLite；生产建议 PostgreSQL 16：
# TG_DATABASE_URL=postgresql+psycopg://traceguard:***@db.internal:5432/traceguard

# ---- 网络出口（RUN-010 WP2）----
# 目标额外授权 origin（除 TeamFlow 外）；未授权地址在请求发出前阻断
# TG_TARGET_EXTRA_ORIGINS=["http://127.0.0.1:8011"]
